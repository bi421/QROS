# Auto detect text files and normalize line endings to LF
* text=auto

# YAML workflows MUST stay LF (GitHub Actions requirement)
.github/workflows/*.yml text eol=lf

# Python files
*.py text eol=lf
*.pyi text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Exclude binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.gz binary
*.tar binary
