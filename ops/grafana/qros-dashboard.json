{
  "title": "QROS SaaS Overview",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {"type":"stat","title":"HTTP Requests","targets":[{"expr":"qros_http_requests_total"}]},
    {"type":"stat","title":"HTTP 5xx","targets":[{"expr":"qros_http_errors_total"}]},
    {"type":"timeseries","title":"HTTP Request Rate","targets":[{"expr":"rate(qros_http_requests_total[5m])"}]},
    {"type":"timeseries","title":"HTTP 5xx Rate","targets":[{"expr":"rate(qros_http_errors_total[5m])"}]},
    {"type":"timeseries","title":"HTTP p95 Latency (ms)","targets":[{"expr":"histogram_quantile(0.95, rate(qros_http_request_duration_ms_bucket[5m]))"}]}
  ]
}
