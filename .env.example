# QROS SaaS production/local-container configuration.
# Never commit real credentials.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY

# Required to enable the billing webhook endpoint.
BILLING_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# Optional application settings documented here for future deployment layers.
# QROS currently reads the three variables above from the production composition root.
