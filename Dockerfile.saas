FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system researchos && adduser --system --ingroup researchos researchos

COPY pyproject.toml README.md ./
COPY researchos ./researchos
COPY scripts ./scripts
COPY financial_research_lab ./financial_research_lab

RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir '.[saas]'

USER researchos

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3).read()"

CMD ["uvicorn", "researchos.saas.api:app", "--host", "0.0.0.0", "--port", "8000"]
